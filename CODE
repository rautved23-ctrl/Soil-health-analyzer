void handleNotFound() {
  setCorsHeaders();
  if (server.method() == HTTP_OPTIONS) {
    server.send(204);
  } else {
    server.send(404, "application/json", "{\"status\":\"error\",\"message\":\"Not found\"}");
  }
}

void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("\n==========================================");
  Serial.println(" BhoomiMitra ESP32 Direct Telemetry Unit ");
  Serial.println("  100% True Sensor Data - No Cloud/Supabase");
  Serial.println("==========================================");

  // Initialize RS485 UART
  Serial2.begin(9600, SERIAL_8N1, RS485_RX, RS485_TX);
  pinMode(MAX485_RE_DE, OUTPUT);
  digitalWrite(MAX485_RE_DE, LOW);

  // Initialize DS18B20 Temperature
  ds18b20.begin();

  // Connect Wi-Fi (SoftAP + STA)
  connectWiFi();

  // Setup Web Server REST Endpoints
  server.on("/", HTTP_GET, handleRoot);
  server.on("/api/readings", HTTP_GET, handleGetReadings);
  server.on("/api/readings", HTTP_OPTIONS, handleOptions);
  server.on("/readings", HTTP_GET, handleGetReadings);
  server.on("/readings", HTTP_OPTIONS, handleOptions);
  server.on("/api/read", HTTP_GET, handleTriggerRead);
  server.on("/api/read", HTTP_POST, handleTriggerRead);
  server.on("/api/read", HTTP_OPTIONS, handleOptions);
  server.on("/read", HTTP_GET, handleTriggerRead);
  server.on("/read", HTTP_POST, handleTriggerRead);
  server.on("/read", HTTP_OPTIONS, handleOptions);
  server.onNotFound(handleNotFound);

  server.begin();
  Serial.println("[HTTP Server] REST API listening on port 80");
  Serial.println("[HTTP Server] Endpoints: /api/readings , /api/read");

  // Perform initial sensor sampling
  readSensors();
}

void loop() {
  // Handle incoming HTTP REST client requests from Web App
  server.handleClient();

  // Check for incoming USB Serial commands from Web Serial / Terminal
  if (Serial.available()) {
    String cmd = Serial.readStringUntil('\n');
    cmd.trim();
    cmd.toUpperCase();

    if (cmd == "READ" || cmd == "GET" || cmd == "SCAN") {
      readSensors();
      String json = buildSensorJson();
      Serial.println(json);
    } else if (cmd == "STATUS" || cmd == "IP") {
      Serial.print("{\"soft_ap_ip\":\"");
      Serial.print(WiFi.softAPIP());
      Serial.print("\",\"sta_ip\":\"");
      Serial.print(WiFi.localIP());
      Serial.println("\"}");
    }
  }

  // Periodic sensor read every 10 seconds to keep cache warm
  static unsigned long lastPeriodicRead = 0;
  if (millis() - lastPeriodicRead >= 10000) {
    lastPeriodicRead = millis();
    readSensors();
  }

  delay(10);
}
